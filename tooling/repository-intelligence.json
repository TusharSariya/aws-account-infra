{
  "schema_version": 1,
  "spec_kit": {
    "source": "https://github.com/github/spec-kit",
    "version": "0.16.4",
    "ref": "v0.16.4",
    "integration": "codex",
    "script": "sh",
    "community_extensions_enabled": false
  },
  "repowise": {
    "source": "https://github.com/repowise-dev/repowise",
    "package": "repowise",
    "version": "0.43.0",
    "ref": "v0.43.0",
    "index_directory": ".repowise",
    "telemetry": false,
    "automatic_hooks": false
  },
  "graphify": {
    "source": "https://github.com/Graphify-Labs/graphify",
    "package": "graphifyy",
    "version": "0.9.45",
    "ref": "v0.9.45",
    "extras": ["terraform", "mcp"],
    "output_directory": "graphify-out",
    "automatic_hooks": false,
    "policy": "reviewed high-risk pull-request snapshots only"
  },
  "terraform_docs": {
    "source": "https://github.com/terraform-docs/terraform-docs",
    "version": "0.24.0",
    "ref": "v0.24.0"
  }
}
