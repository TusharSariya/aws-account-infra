[Unit]
Description=Prototype idle eligibility and demand cancellation (no power-off)
After=network-online.target

[Service]
Environment=PYTHONPATH=%h/.local/share/homelab-capacity/source/src
ExecStart=%h/.local/share/homelab-capacity/venv/bin/python %h/.local/share/homelab-capacity/consolidate.py observe --watch
Restart=on-failure
RestartSec=10
MemoryMax=192M
TasksMax=32
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
