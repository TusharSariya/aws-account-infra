[Unit]
Description=Prototype host-power expansion preferences (read-only power)
After=network-online.target

[Service]
Environment=PYTHONPATH=%h/.local/share/homelab-capacity/source/src
ExecStart=%h/.local/share/homelab-capacity/venv/bin/python %h/.local/share/homelab-capacity/placement.py
Restart=on-failure
RestartSec=10
MemoryMax=128M
TasksMax=32
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
