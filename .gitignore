# OpenTofu / Terraform
.terraform/
# NOTE: .terraform.lock.hcl is intentionally COMMITTED (pins provider hashes).
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local var files with secrets/overrides (commit *.tfvars.example instead)
*.auto.tfvars
*.local.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan artifacts
*.tfplan
plan.json
tfplan.binary

# Editor / OS
.DS_Store
*.swp

# Machine-specific Ansible inventory and Vault credentials
ansible/inventories/local/
.vault-password

# Homelab PKI private material — the CA private key must NEVER be committed.
# The public cert (homelab-ca.crt) is safe but belongs in staging.tfvars, not loose at root.
*.key
homelab-ca.*
homelab-pki/
