# OpenTofu / Terraform
.terraform/
# NOTE: .terraform.lock.hcl is intentionally COMMITTED (pins provider hashes).
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local var files with secrets/overrides (commit *.tfvars.example instead)
*.auto.tfvars
*.local.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan artifacts
*.tfplan
plan.json
tfplan.binary

# Editor / OS
.DS_Store
*.swp

# OpenAPI Generator output and Swagger UI staging (rebuilt in CI)
generated/
build/api-docs/
build/lambda/

# Secrets and local Python (court-booker CLI reads repo-root .env)
.env
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# --- Homelab PKI: NEVER commit private keys or the CA. This is a guardrail, not a
# security boundary — keep real keys outside the checkout (e.g. ~/.config/...).
# The CA's PUBLIC cert is not secret, but it belongs in config/environments/aws/
# staging.tfvars (where the Roles Anywhere trust anchor reads it), not loose at root.
*.key
*.srl
# NOT `homelab-ca.*` — that pattern is unanchored, so it matches at ANY depth and
# silently swallowed docs/plans/homelab-ca.md. Private keys stay covered by *.key
# above; list the CA's other artefacts explicitly so the stem stays usable for docs.
homelab-ca.crt
homelab-ca.crt.bak
homelab-ca.pem
homelab-pki/
# Obsolete Mac-minted node material (superseded by the on-node CSR flow); safe to rm.
desktop.crt
desktop.csr

# Ad-hoc Pi-hole /etc backup: 16MB of runtime state including tls.pem (a PRIVATE KEY)
# and cli_pw. Ignored so a stray `git add -A` cannot publish it. This is host state,
# not repo content — it belongs outside the checkout entirely.
pihole-etc-backup/

# Retired machine-specific inventory and Vault-password files remain private.
.vault-password
vault-password
ansible/inventories/local/

# Generated Talos secrets stay outside Git.
talos-secrets.yaml
*.machineconfig.yaml
talosconfig

# Private pilot VM disks, archives, and cluster recovery state.
*.qcow2
pilot-*.tar.gz
pilot-*.tar.partial
pilot-recovery*/
etcd.snapshot
kubeconfig
