{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "monitoring",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "prometheus",
        "namespace": "monitoring"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "prometheus",
        "namespace": "monitoring"
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 30s\n  evaluation_interval: 30s\nrule_files: [/etc/monitoring/alerts.yml]\nalerting:\n  alertmanagers:\n    - static_configs:\n        - targets: ['alertmanager:9093']\nscrape_configs:\n  - job_name: monitoring\n    static_configs:\n      - targets: ['prometheus:9090', 'loki:3100', 'alloy:12345', 'grafana:3000', 'alertmanager:9093']\n  - job_name: kubelet\n    scheme: https\n    authorization:\n      credentials_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    tls_config:\n      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\n    static_configs:\n      - targets: ['10.0.0.221:10250']\n        labels: {node: talos-cp-01}\n      - targets: ['10.0.0.222:10250']\n        labels: {node: talos-worker-01}\n      - targets: ['10.0.0.225:10250']\n        labels: {node: talos-worker-02}\n    metric_relabel_configs:\n      - source_labels: [__name__]\n        regex: 'kubelet_volume_stats_.*|kubelet_running_pods|kubelet_running_containers|process_.*'\n        action: keep\n",
        "alerts.yml": "groups:\n  - name: platform\n    rules:\n      - alert: MonitoringTargetDown\n        expr: up{job=\"monitoring\"} == 0\n        for: 3m\n        labels: {severity: warning}\n        annotations: {summary: 'Monitoring target {{ $labels.instance }} is unavailable'}\n      - alert: WorkerUnavailable\n        expr: up{job=\"kubelet\",node=~\"talos-worker-.*\"} == 0\n        for: 5m\n        labels: {severity: warning}\n        annotations: {summary: 'Worker {{ $labels.node }} is unavailable; check laptop maintenance journal and silences'}\n      - alert: ControlPlaneUnavailable\n        expr: up{job=\"kubelet\",node=\"talos-cp-01\"} == 0\n        for: 2m\n        labels: {severity: critical}\n        annotations: {summary: 'Control-plane kubelet cannot be scraped'}\n      - alert: PlatformVolumeNearlyFull\n        expr: kubelet_volume_stats_available_bytes{namespace=\"monitoring\"} / kubelet_volume_stats_capacity_bytes{namespace=\"monitoring\"} < 0.2\n        for: 5m\n        labels: {severity: warning}\n        annotations: {summary: 'Monitoring volume has less than 20 percent free'}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "prometheus",
        "namespace": "monitoring"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-primary",
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "monitoring"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "monitoring"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "serviceAccountName": "prometheus",
            "automountServiceAccountToken": true,
            "nodeSelector": {
              "homelab.tfdraw.dev/worker-role": "primary",
              "homelab.tfdraw.dev/storage": "local-primary"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "runAsGroup": 65534,
              "fsGroup": 65534,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "docker.io/prom/prometheus:v3.14.0@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0",
                "args": [
                  "--config.file=/etc/monitoring/prometheus.yml",
                  "--storage.tsdb.path=/data",
                  "--storage.tsdb.retention.time=48h",
                  "--storage.tsdb.retention.size=8GB"
                ],
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1536Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/monitoring",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/-/healthy",
                    "port": 9090
                  },
                  "periodSeconds": 20,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "prometheus"
                }
              },
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "loki",
        "namespace": "monitoring"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "loki",
        "namespace": "monitoring"
      },
      "data": {
        "loki.yml": "auth_enabled: false\nserver:\n  log_level: warn\n  http_listen_address: 0.0.0.0\n  http_listen_port: 3100\n  grpc_listen_address: 127.0.0.1\n  grpc_listen_port: 9096\ncommon:\n  instance_addr: 127.0.0.1\n  path_prefix: '/data'\n  storage:\n    filesystem:\n      chunks_directory: '/data/chunks'\n      rules_directory: '/data/rules'\n  replication_factor: 1\n  ring:\n    kvstore:\n      store: inmemory\nschema_config:\n  configs:\n    - from: 2024-01-01\n      store: tsdb\n      object_store: filesystem\n      schema: v13\n      index:\n        prefix: index_\n        period: 24h\ncompactor:\n  working_directory: '/data/compactor'\n  retention_enabled: true\n  delete_request_store: filesystem\n  retention_delete_delay: 1h\nlimits_config:\n  retention_period: 48h\n  ingestion_rate_mb: 1\n  ingestion_burst_size_mb: 2\n  max_global_streams_per_user: 200\n  max_line_size: 4096\n  max_query_parallelism: 2\n  split_queries_by_interval: 1h\n  max_query_lookback: 48h\n  reject_old_samples: true\n  reject_old_samples_max_age: 48h\nquerier:\n  max_concurrent: 1\nquery_range:\n  cache_results: false\nanalytics:\n  reporting_enabled: false\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "loki",
        "namespace": "monitoring"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-primary",
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "loki",
        "namespace": "monitoring"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "loki"
        },
        "ports": [
          {
            "name": "http",
            "port": 3100,
            "targetPort": 3100
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "loki",
        "namespace": "monitoring"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "loki"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "loki"
            }
          },
          "spec": {
            "serviceAccountName": "loki",
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "homelab.tfdraw.dev/worker-role": "primary",
              "homelab.tfdraw.dev/storage": "local-primary"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "runAsGroup": 65534,
              "fsGroup": 65534,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "loki",
                "image": "docker.io/grafana/loki:3.7.8@sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193",
                "args": [
                  "-config.file=/etc/monitoring/loki.yml"
                ],
                "ports": [
                  {
                    "containerPort": 3100
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1024Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/monitoring",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 3100
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 3100
                  },
                  "periodSeconds": 20,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 3100
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "loki"
                }
              },
              {
                "name": "config",
                "configMap": {
                  "name": "loki"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "grafana",
        "namespace": "monitoring"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "grafana",
        "namespace": "monitoring"
      },
      "data": {
        "datasources.yml": "apiVersion: 1\ndatasources:\n  - {name: Prometheus, uid: main-prometheus, type: prometheus, access: proxy, url: 'http://prometheus:9090', isDefault: true, editable: false}\n  - {name: Loki, uid: main-loki, type: loki, access: proxy, url: 'http://loki:3100', editable: false}\n",
        "dashboards.yml": "apiVersion: 1\nproviders:\n  - name: main\n    type: file\n    orgId: 1\n    disableDeletion: true\n    editable: false\n    options: {path: /etc/monitoring}\n",
        "dashboard.json": "{\n  \"uid\": \"main-platform\",\n  \"title\": \"Main platform\",\n  \"schemaVersion\": 39,\n  \"version\": 1,\n  \"refresh\": \"30s\",\n  \"time\": {\n    \"from\": \"now-1h\",\n    \"to\": \"now\"\n  },\n  \"panels\": [\n    {\n      \"id\": 1,\n      \"type\": \"timeseries\",\n      \"title\": \"Scrape health\",\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"main-prometheus\"\n      },\n      \"gridPos\": {\n        \"x\": 0,\n        \"y\": 0,\n        \"w\": 12,\n        \"h\": 8\n      },\n      \"targets\": [\n        {\n          \"refId\": \"A\",\n          \"expr\": \"up\"\n        }\n      ]\n    },\n    {\n      \"id\": 2,\n      \"type\": \"timeseries\",\n      \"title\": \"Process memory\",\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"main-prometheus\"\n      },\n      \"gridPos\": {\n        \"x\": 12,\n        \"y\": 0,\n        \"w\": 12,\n        \"h\": 8\n      },\n      \"targets\": [\n        {\n          \"refId\": \"A\",\n          \"expr\": \"process_resident_memory_bytes{job=\\\"monitoring\\\"}\"\n        }\n      ]\n    },\n    {\n      \"id\": 3,\n      \"type\": \"timeseries\",\n      \"title\": \"Monitoring storage free\",\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"main-prometheus\"\n      },\n      \"gridPos\": {\n        \"x\": 0,\n        \"y\": 8,\n        \"w\": 12,\n        \"h\": 8\n      },\n      \"targets\": [\n        {\n          \"refId\": \"A\",\n          \"expr\": \"kubelet_volume_stats_available_bytes{namespace=\\\"monitoring\\\"}\"\n        }\n      ]\n    },\n    {\n      \"id\": 4,\n      \"type\": \"timeseries\",\n      \"title\": \"Active alerts\",\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"main-prometheus\"\n      },\n      \"gridPos\": {\n        \"x\": 12,\n        \"y\": 8,\n        \"w\": 12,\n        \"h\": 8\n      },\n      \"targets\": [\n        {\n          \"refId\": \"A\",\n          \"expr\": \"ALERTS{alertstate=\\\"firing\\\"}\"\n        }\n      ]\n    }\n  ]\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "grafana",
        "namespace": "monitoring"
