                "configMap": {
                  "name": "grafana"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "alloy",
        "namespace": "monitoring"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "alloy",
        "namespace": "monitoring"
      },
      "data": {
        "alloy.alloy": "logging {\n  level = \"warn\"\n}\ndiscovery.kubernetes \"main\" {\n  role = \"pod\"\n  namespaces {\n    names = [\"monitoring\"]\n  }\n  selectors {\n    role = \"pod\"\n    label = \"monitoring.homelab/main-logs=true\"\n  }\n}\ndiscovery.relabel \"main\" {\n  targets = discovery.kubernetes.main.targets\n  rule {\n    source_labels = [\"__meta_kubernetes_namespace\"]\n    target_label = \"namespace\"\n  }\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_name\"]\n    target_label = \"pod\"\n  }\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_container_name\"]\n    target_label = \"container\"\n  }\n}\nloki.source.kubernetes \"main\" {\n  targets = discovery.relabel.main.output\n  forward_to = [loki.process.main.receiver]\n}\nloki.process \"main\" {\n  // Only fixed-format diagnostic markers are stored. Request bodies and ordinary\n  // workload output never enter Loki, even on an opted-in Pod.\n  stage.match {\n    selector = \"{namespace=~\\\".+\\\"} !~ \\\"^main-observe [a-zA-Z0-9_-]{1,80}[[:space:]]*$\\\"\"\n    action = \"drop\"\n  }\n  forward_to = [loki.write.local.receiver]\n}\nloki.write \"local\" {\n  endpoint {\n    url = \"http://loki:3100/loki/api/v1/push\"\n  }\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "alloy",
        "namespace": "monitoring"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-primary",
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "alloy",
        "namespace": "monitoring"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "alloy"
        },
        "ports": [
          {
            "name": "http",
            "port": 12345,
            "targetPort": 12345
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "alloy",
        "namespace": "monitoring"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
