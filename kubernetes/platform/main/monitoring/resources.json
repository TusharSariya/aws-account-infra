            "port": 3000,
            "targetPort": 3000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "grafana",
        "namespace": "monitoring"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
