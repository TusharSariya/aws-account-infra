                  "failureThreshold": 60
                },
                "env": [
                  {
                    "name": "GF_PATHS_DATA",
                    "value": "/data"
                  },
                  {
                    "name": "GF_PATHS_LOGS",
                    "value": "/data/logs"
                  },
                  {
