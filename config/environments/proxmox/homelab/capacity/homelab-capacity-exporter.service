[Unit]
Description=Private authenticated read-only capacity snapshot
After=network-online.target tailscaled.service homelab-capacity-sample.service
Wants=network-online.target homelab-capacity-sample.service
[Service]
Type=simple
User=homelab-capacity
Group=homelab-capacity
ExecStart=/usr/bin/python3 -B /usr/local/lib/homelab-capacity/physical_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
