{
  "version": 1,
  "units": [
    {
      "id": "aws-staging-account",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/account",
      "var_file": "config/environments/aws/staging/account.tfvars",
      "region": "us-east-1",
      "dependencies": [],
      "ci": true,
      "watch": [
        "live/aws/staging/account/",
        "config/environments/aws/staging/account.tfvars",
        "modules/aws/account_artifacts/",
        "modules/aws/account_identity/",
        "modules/aws/account_governance/"
      ]
    },
    {
      "id": "aws-staging-rag",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/rag",
      "var_file": "config/environments/aws/staging/rag.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/rag/",
        "config/environments/aws/staging/rag.tfvars",
        "modules/aws/encrypted_s3_bucket/",
        "modules/aws/ecr_repository/"
      ]
    },
    {
      "id": "aws-staging-court-booker",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/court-booker",
      "var_file": "config/environments/aws/staging/court-booker.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/court-booker/",
        "apps/ecr/court-booker/bookings.yaml",
        "config/environments/aws/staging/court-booker.tfvars",
        "modules/aws/ecr_repository/"
      ]
    },
    {
      "id": "aws-staging-court-booker-api",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/lambda/python/court-booker",
      "var_file": "config/environments/aws/staging/court-booker-api.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account",
        "aws-staging-court-booker"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/lambda/python/court-booker/",
        "apps/ecr/court-booker/bookings.yaml",
        "apps/lambda/python/3.14/court-booker/",
        "config/environments/aws/staging/court-booker-api.tfvars"
      ]
    },
    {
      "id": "aws-staging-homelab-recovery",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/homelab-recovery",
      "var_file": "config/environments/aws/staging/homelab-recovery.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/homelab-recovery/",
        "modules/aws/encrypted_s3_bucket/",
        "config/environments/aws/staging/homelab-recovery.tfvars"
      ]
    },
    {
      "id": "proxmox-homelab",
      "cloud": "proxmox",
      "environment": "homelab",
      "path": "live/proxmox/homelab",
      "var_file": "config/environments/proxmox/homelab/vms.tfvars",
      "dependencies": [],
      "ci": true,
      "watch": [
        "live/proxmox/homelab/",
        "config/environments/proxmox/homelab/",
        "scripts/proxmox-ci-check.py"
      ]
    },
    {
      "id": "talos-homelab",
      "cloud": "talos",
      "environment": "homelab",
      "path": "live/talos/homelab",
      "var_file": "config/environments/talos/homelab/cluster.tfvars",
      "dependencies": [
        "proxmox-homelab"
      ],
      "ci": true,
      "watch": [
        "live/talos/homelab/",
        "config/environments/talos/homelab/",
        "config/environments/proxmox/homelab/talos/",
        "scripts/talos-ci.py",
        "scripts/talos_tools.py",
        ".github/actions/talos-deploy/",
        "scripts/homelab-talos-config.py"
      ]
    },
    {
      "id": "kubernetes-homelab",
      "cloud": "kubernetes",
      "environment": "homelab",
      "path": "live/kubernetes/homelab",
      "var_file": "config/environments/kubernetes/homelab/apps.tfvars",
      "dependencies": [
        "talos-homelab"
      ],
      "ci": true,
      "watch": [
        "live/kubernetes/homelab/",
        "config/environments/kubernetes/homelab/",
        "scripts/homelab-apps.py",
        "scripts/issue-capacity-credentials.py",
        "scripts/quota-acceptance.py",
        ".github/workflows/homelab-quota-acceptance.yml",
        "scripts/enroll-capacity-host-key.sh",
        ".github/actions/kubernetes-deploy/",
        "charts/homelab-ollama/",
        "charts/homelab-odysseus/",
        "charts/homelab-capacity/",
        "charts/homelab-ai/",
        "apps/platform/storage/",
        "apps/platform/migration/",
        "apps/platform/lifecycle/",
        "apps/containers/ollama/",
        "apps/containers/odysseus/",
        "scripts/ollama-image-context.py",
        "scripts/ollama-image-smoke.sh",
        "scripts/odysseus-image-context.py",
        ".github/workflows/ollama-image.yml",
        ".github/workflows/odysseus-image.yml",
        "scripts/tests/test_lifecycle_",
        "scripts/tests/test_odysseus_activity.py",
        "scripts/tests/test_odysseus_processes.py",
        "scripts/tests/test_odysseus_http.py",
        "charts/homelab-lifecycle/",
        "charts/homelab-jobs/",
        "scripts/odysseus-image-smoke.sh",
        "scripts/odysseus-smoke-controller.py",
        "apps/platform/jobs/",
        "scripts/issue-lifecycle-credentials.py",
        "scripts/homelab-lifecycle-validate.py",
        "scripts/odysseus-source-tests.py",
        "scripts/verify-ai-images.py",
        "scripts/ai-control.py",
        "scripts/argo-client-token.py",
        "apps/platform/recovery/",
        "scripts/lifecycle_session.py",
        "scripts/ai-data-backup.py",
        "scripts/odysseus-backup.sh",
        "scripts/tests/test_odysseus_backup.py",
        "scripts/tests/test_homelab_apps.py",
        "scripts/homelab-lifecycle-maintenance.py",
        ".github/workflows/homelab-lifecycle-maintenance.yml",
        "scripts/odysseus-document-acceptance.py",
        "scripts/odysseus-scheduler-acceptance.py",
        "scripts/local_lifecycle_record.py",
        "scripts/local_lifecycle_tools.py",
        "scripts/homelab-lifecycle-local.py",
        "scripts/tests/test_local_lifecycle.py"
      ]
    },
    {
      "id": "kubernetes-homelab-ci",
      "cloud": "kubernetes",
      "environment": "homelab",
      "path": "live/kubernetes/homelab-ci",
      "var_file": "config/environments/kubernetes/homelab-ci/ci.tfvars",
      "dependencies": [
        "talos-homelab"
      ],
      "ci": false,
      "watch": [
        "live/kubernetes/homelab-ci/",
        "config/environments/kubernetes/homelab-ci/",
        "charts/homelab-queue/",
        "scripts/homelab-ci.py",
        "scripts/kueue-postrender.py",
        "scripts/kueue_capacity.py",
        ".github/workflows/homelab-ci-admission.yml",
        "scripts/runner_catalog.py"
      ]
    }
  ]
}
