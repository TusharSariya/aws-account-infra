{
  "version": 1,
  "units": [
    {
      "id": "aws-staging-account",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/account",
      "var_file": "config/environments/aws/staging/account.tfvars",
      "region": "us-east-1",
      "dependencies": [],
      "ci": true,
      "watch": [
        "live/aws/staging/account/",
        "modules/aws/",
        "config/environments/aws/staging/account.tfvars"
      ]
    },
    {
      "id": "aws-staging-rag",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/rag",
      "var_file": "config/environments/aws/staging/rag.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/rag/",
        "modules/aws/",
        "config/environments/aws/staging/rag.tfvars"
      ]
    },
    {
      "id": "aws-staging-court-booker",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/court-booker",
      "var_file": "config/environments/aws/staging/court-booker.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/court-booker/",
        "modules/aws/",
        "apps/ecr/court-booker/bookings.yaml",
        "config/environments/aws/staging/court-booker.tfvars"
      ]
    },
    {
      "id": "aws-staging-court-booker-api",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/lambda/python/court-booker",
      "var_file": "config/environments/aws/staging/court-booker-api.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account",
        "aws-staging-court-booker"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/lambda/python/court-booker/",
        "modules/aws/",
        "apps/ecr/court-booker/bookings.yaml",
        "apps/lambda/python/3.14/court-booker/",
        "config/environments/aws/staging/court-booker-api.tfvars"
      ]
    },
    {
      "id": "aws-staging-homelab-recovery",
      "cloud": "aws",
      "environment": "staging",
      "path": "live/aws/staging/workloads/homelab-recovery",
      "var_file": "config/environments/aws/staging/homelab-recovery.tfvars",
      "region": "us-east-1",
      "dependencies": [
        "aws-staging-account"
      ],
      "ci": true,
      "watch": [
        "live/aws/staging/workloads/homelab-recovery/",
        "modules/aws/encrypted_s3_bucket/",
        "config/environments/aws/staging/homelab-recovery.tfvars"
      ]
    },
    {
      "id": "proxmox-homelab",
      "cloud": "proxmox",
      "environment": "homelab",
      "path": "live/proxmox/homelab",
      "var_file": "config/environments/proxmox/homelab/vms.tfvars",
      "dependencies": [],
      "ci": true,
      "watch": [
        "live/proxmox/homelab/",
        "config/environments/proxmox/homelab/",
        "scripts/proxmox-ci-check.py"
      ]
    },
    {
      "id": "talos-homelab",
      "cloud": "talos",
      "environment": "homelab",
      "path": "live/talos/homelab",
      "var_file": "config/environments/talos/homelab/cluster.tfvars",
      "dependencies": [
        "proxmox-homelab"
      ],
      "ci": true,
      "watch": [
        "live/talos/homelab/",
        "config/environments/talos/homelab/",
        "config/environments/proxmox/homelab/talos/",
        "scripts/talos-ci.py",
        "scripts/talos_tools.py",
        ".github/actions/talos-deploy/",
        "scripts/homelab-talos-config.py"
      ]
    },
    {
      "id": "kubernetes-homelab",
      "cloud": "kubernetes",
      "environment": "homelab",
      "path": "live/kubernetes/homelab",
      "var_file": "config/environments/kubernetes/homelab/apps.tfvars",
      "dependencies": [
        "talos-homelab"
      ],
      "ci": true,
      "watch": [
        "live/kubernetes/homelab/",
        "config/environments/kubernetes/homelab/",
        "scripts/homelab-apps.py",
        "scripts/issue-capacity-credentials.py",
        "scripts/enroll-capacity-host-key.sh",
        ".github/actions/kubernetes-deploy/",
        "charts/homelab-ollama/",
        "charts/homelab-odysseus/",
        "charts/homelab-capacity/",
        "charts/homelab-ai/",
        "apps/platform/storage/",
        "apps/platform/migration/"
      ]
    }
  ]
}
