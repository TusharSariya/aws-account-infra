    "port": 11434,
    "startAI": true,
    "clients": [
      "playground-router"
    ]
  },
  {
    "name": "wake-odysseus",
    "namespace": "homelab-models",
    "host": "primary",
    "upstream": "odysseus.homelab-models.svc.cluster.local",
    "port": 7000,
    "startAI": true
  },
  {
    "name": "wake-lifecycle",
    "namespace": "homelab-platform",
    "host": "primary",
    "upstream": "ai-lifecycle.homelab-platform.svc.cluster.local",
    "port": 8080,
    "wakePaths": "/start"
  },
  {
    "name": "wake-playground",
    "namespace": "homelab-models",
