# Brewfile.ops — infrastructure, cloud and Kubernetes tooling
#
# Managed by the `homebrew` Ansible role. `brew bundle` ensures these are
# installed; the role warns (never removes) about anything installed but not
# declared in a Brewfile.

# Third-party tap for the supabase CLI below
tap "supabase/tap"

# Automate deployment, configuration, and upgrading
brew "ansible"
# Official Amazon AWS command-line interface
brew "awscli"
# CLI to install, manage & troubleshoot Kubernetes clusters running Cilium
brew "cilium-cli"
# The Kubernetes package manager (also required by the helm-diff plugin that
# the admin_workstation role pins)
brew "helm"
# Deploy Kubernetes Helm Charts
brew "helmfile"
# Kubernetes CLI To Manage Your Clusters In Style!
brew "k9s"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Run local Kubernetes cluster in Docker
brew "kind"
# Linux virtual machines
brew "lima"
# Editor of encrypted files
brew "sops"
# OpenTofu / Terraform / Terragrunt / Terramate / Atmos version manager
brew "tenv"
# Daemon to provide vmnet.framework support for rootless QEMU
brew "socket_vmnet"
# PAM module for two-factor authentication
brew "google-authenticator-libpam"
# Supabase CLI
brew "supabase/tap/supabase", trusted: true

# Set of tools to manage resources and applications hosted on Google Cloud
cask "gcloud-cli"
