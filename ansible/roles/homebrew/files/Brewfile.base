# Brewfile.base — shell and CLI foundations
#
# Managed by the `homebrew` Ansible role. `brew bundle` ensures these are
# installed; the role warns (never removes) about anything installed but not
# declared in a Brewfile. Regenerate a starting point with `brew bundle dump`.

# Bourne-Again SHell, a UNIX command interpreter
brew "bash"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"
# GNU File, Shell, and Text utilities
brew "coreutils"
# GNU version of the tar archiving utility
brew "gnu-tar"
# Get a file from an HTTP, HTTPS or FTP server
brew "curl"
# Internet file retriever
brew "wget"
# Distributed revision control system
brew "git"
# GitHub command-line tool
brew "gh"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Terminal multiplexer
brew "tmux"
# Resource monitor. C++ version and continuation of bashtop and bpytop
brew "btop"
# Improved top (interactive process viewer)
brew "htop"
# NCurses Disk Usage
brew "ncdu"
# Terminal bandwidth utilization tool
brew "bandwhich"
