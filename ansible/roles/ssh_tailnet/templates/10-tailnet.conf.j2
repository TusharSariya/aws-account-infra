# Managed by Ansible (role: ssh_tailnet). Manual edits will be overwritten.
#
# sshd keeps the FIRST value it sees for a keyword, so this drop-in only takes
# effect because /etc/ssh/sshd_config's Include line precedes any competing
# directive. The role asserts that Include is present.
{% for address in ssh_tailnet_listen_addresses %}
ListenAddress {{ address }}
{% endfor %}
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
{% if ssh_tailnet_allow_users | length > 0 %}
AllowUsers {{ ssh_tailnet_allow_users | join(' ') }}
{% endif %}
