apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_harvester_secret }}
  namespace: {{ cluster_harvester_namespace }}
type: Opaque
stringData:
  SUPABASE_URL: {{ vault_harvester_supabase_url | to_json }}
  SUPABASE_SERVICE_KEY: {{ vault_harvester_service_key | to_json }}
  UNPAYWALL_EMAIL: {{ cluster_harvester_unpaywall_email | to_json }}
  CROSSREF_MAILTO: {{ cluster_harvester_crossref_mailto | to_json }}
{% if vault_harvester_core_api_key is defined and 'REPLACE_' not in vault_harvester_core_api_key %}
  CORE_API_KEY: {{ vault_harvester_core_api_key | to_json }}
{% endif %}
