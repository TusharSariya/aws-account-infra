#cloud-config
users:
  - default
  - name: "{{ multipass_worker_user }}"
    groups:
      - adm
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - "{{ lookup('file', multipass_worker_ssh_public_key_path) }}"
package_update: true
packages:
  - openssh-server
ssh_pwauth: false
