apiVersion: v1
kind: Config
clusters:
- name: main
  cluster:
    server: {{ worker_enrollment_api }}
    certificate-authority: /etc/kubernetes/ca.crt
users:
- name: bootstrap
  user:
    token: {{ worker_enrollment_bootstrap_token }}
contexts:
- name: main
  context: {cluster: main, user: bootstrap}
current-context: main
