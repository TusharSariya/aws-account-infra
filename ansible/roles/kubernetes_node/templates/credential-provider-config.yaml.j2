# Managed by Ansible (kubernetes_node role). Tells kubelet to call the
# ecr-credential-provider plugin for images from the homelab ECR registry. The
# plugin sources its AWS credentials from the AWS config file below, whose
# [default] profile runs aws_signing_helper as a credential_process (IAM Roles
# Anywhere) to vend short-lived STS creds — no static access key.
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    matchImages:
      - "{{ kubernetes_node_ecr_registry }}"
    defaultCacheDuration: "12h"
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    args:
      - get-credentials
    env:
      - name: AWS_REGION
        value: "{{ kubernetes_node_ecr_region }}"
      - name: AWS_CONFIG_FILE
        value: "{{ kubernetes_node_ecr_aws_config_file }}"
      - name: AWS_SDK_LOAD_CONFIG
        value: "1"
