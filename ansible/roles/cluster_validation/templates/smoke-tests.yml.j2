---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cluster_validation_namespace }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: gpu-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        accelerator: nvidia
      containers:
        - name: nvidia-smi
          image: {{ cluster_validation_gpu_image }}
          command:
            - nvidia-smi
          resources:
            limits:
              nvidia.com/gpu: 1
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: local-storage-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: 64Mi
---
apiVersion: batch/v1
kind: Job
metadata:
  name: storage-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        storage: local
      containers:
        - name: storage
          image: registry.k8s.io/e2e-test-images/busybox:1.36.1-1
          command:
            - sh
            - -ec
            - echo persistent-storage-ok > /data/result && grep -q persistent-storage-ok /data/result
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: local-storage-smoke
{% if groups['legacy_nodes'] | default([]) | length > 0 %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: legacy-cpu-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        hardware-tier: legacy
      tolerations:
        - key: workload-tier
          operator: Equal
          value: light
          effect: NoSchedule
      containers:
        - name: cpu
          image: registry.k8s.io/e2e-test-images/busybox:1.36.1-1
          command: ["sh", "-ec", "test $(uname -m) = x86_64"]
{% endif %}
{% if groups['ephemeral_nodes'] | default([]) | length > 0 %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: arm64-cpu-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        kubernetes.io/arch: arm64
      tolerations:
        - key: lifecycle
          operator: Equal
          value: ephemeral
          effect: NoSchedule
      containers:
        - name: cpu
          image: registry.k8s.io/e2e-test-images/busybox:1.36.1-1
          command: ["sh", "-ec", "test $(uname -m) = aarch64"]
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ingress-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ingress-smoke
  template:
    metadata:
      labels:
        app: ingress-smoke
    spec:
      nodeSelector:
        hardware-tier: gpu
      containers:
        - name: nginx
          image: nginx:1.29.4-alpine
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: ingress-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  selector:
    app: ingress-smoke
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: gateway-smoke
  namespace: {{ cluster_validation_namespace }}
spec:
  parentRefs:
    - name: {{ cluster_validation_gateway_name }}
      namespace: {{ cluster_validation_gateway_namespace }}
      sectionName: http
  hostnames:
    - {{ cluster_validation_gateway_hostname }}
  rules:
    - backendRefs:
        - name: ingress-smoke
          port: 80
