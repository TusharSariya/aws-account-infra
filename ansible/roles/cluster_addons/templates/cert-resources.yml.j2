---
# cert-manager ACME issuers + the homelab wildcard certificate.
#
# Rendered by the cluster_addons role. Applied AFTER gateway-resources.yml,
# because the Certificate below lands in the Gateway's namespace, which that
# template is what creates.
#
# Design: docs/superpowers/specs/2026-07-16-homelab-pki-design.md
# Install record: docs/plans/cert-manager.md

# The Cloudflare API token used by the DNS-01 solver.
#
# It lives in the cert-manager namespace, NOT the Gateway's: a ClusterIssuer
# resolves secretRefs in the "cluster resource namespace", which defaults to the
# namespace cert-manager itself runs in. Putting it beside the Certificate would
# silently fail to resolve.
#
# Scope: Zone:DNS:Edit + Zone:Zone:Read, restricted to the single zone below.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: {{ vault_cloudflare_api_token | quote }}
---
# Staging issuer. Untrusted by browsers on purpose — its job is to prove the
# DNS-01 loop (token scope, zone lookup, TXT write, self-check past Pi-hole)
# against Let's Encrypt's generous staging limits before touching prod, where
# 5 failed validations/hour and 5 duplicate certs/week lock you out for a week.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-staging
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: {{ cluster_addons_acme_email | quote }}
    privateKeySecretRef:
      name: letsencrypt-staging-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
        selector:
          dnsZones:
            - {{ cluster_addons_cloudflare_zone | quote }}
---
# Production issuer. Defined alongside staging so the cutover is a one-variable
# change (cluster_addons_acme_issuer), not a new manifest.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ cluster_addons_acme_email | quote }}
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
        selector:
          dnsZones:
            - {{ cluster_addons_cloudflare_zone | quote }}
---
# One wildcard for every homelab service.
#
# Both names are listed deliberately: a wildcard does NOT match its own parent,
# so "*.homelab.tfdraw.dev" alone would not cover "homelab.tfdraw.dev".
#
# Wildcard rather than per-service certs because every Let's Encrypt issuance is
# published permanently to Certificate Transparency logs. Per-service certs would
# publish grafana./pihole./every-future-service to the world; this publishes only
# the fact that a homelab exists.
#
# Wildcards REQUIRE DNS-01 — HTTP-01 cannot satisfy them. No constraint here:
# DNS-01 is already the choice, since it needs no inbound connectivity at all.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: homelab-wildcard
  namespace: {{ cluster_addons_gateway_namespace }}
spec:
  # The Gateway's HTTPS listener will reference this secret by name.
  secretName: homelab-tls
  issuerRef:
    name: {{ cluster_addons_acme_issuer | quote }}
    kind: ClusterIssuer
  commonName: {{ cluster_addons_homelab_domain | quote }}
  dnsNames:
    - {{ cluster_addons_homelab_domain | quote }}
    - {{ ('*.' ~ cluster_addons_homelab_domain) | quote }}
