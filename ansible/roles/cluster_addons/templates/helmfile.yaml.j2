---
helmDefaults:
  wait: true
  timeout: 900
  atomic: true

repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: kedacore
    url: https://kedacore.github.io/charts
  - name: metallb
    url: https://metallb.github.io/metallb
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server
  - name: nvidia
    url: https://helm.ngc.nvidia.com/nvidia
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

releases:
  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: "{{ cluster_addons_cilium_version }}"
    values:
      - ipam:
          mode: kubernetes
        kubeProxyReplacement: false
        routingMode: tunnel
        tunnelProtocol: vxlan
        operator:
          replicas: 1

  - name: metallb
    namespace: metallb-system
    createNamespace: true
    chart: metallb/metallb
    version: "{{ cluster_addons_metallb_version }}"

  - name: metrics-server
    namespace: kube-system
    chart: metrics-server/metrics-server
    version: "{{ cluster_addons_metrics_server_version }}"
    values:
      - args:
          - --kubelet-preferred-address-types=InternalIP,Hostname
          - --kubelet-insecure-tls

  - name: keda
    namespace: keda
    createNamespace: true
    chart: kedacore/keda
    version: "{{ cluster_addons_keda_version }}"

  - name: local-path-provisioner
    namespace: local-path-storage
    createNamespace: true
    chart: "{{ cluster_addons_work_dir }}/local-path-provisioner/deploy/chart/local-path-provisioner"
    values:
      - helperImage:
          repository: registry.k8s.io/e2e-test-images/busybox
          tag: 1.36.1-1
        nodeSelector:
          storage: local
        storageClass:
          defaultClass: true
          reclaimPolicy: Retain
        nodePathMap:
          - node: DEFAULT_PATH_FOR_NON_LISTED_NODES
            paths:
              - "{{ cluster_addons_local_storage_path }}"

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: nvidia/gpu-operator
    version: "{{ cluster_addons_gpu_operator_version }}"
    disableValidationOnInstall: true
    values:
      - driver:
          enabled: {{ kubernetes_gpu_operator_manage_driver | bool | lower }}
        toolkit:
          enabled: {{ kubernetes_gpu_operator_manage_toolkit | bool | lower }}
        operator:
          defaultRuntime: containerd

  - name: istio-base
    namespace: istio-system
    createNamespace: true
    chart: istio/base
    version: "{{ cluster_addons_istio_version }}"

  - name: istiod
    namespace: istio-system
    createNamespace: true
    chart: istio/istiod
    version: "{{ cluster_addons_istio_version }}"
    needs:
      - istio-system/istio-base
    values:
      - pilot:
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 1Gi

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: "{{ cluster_addons_kube_prometheus_stack_version }}"
    disableValidationOnInstall: true
    values:
      - prometheus:
          prometheusSpec:
            retention: 7d
            retentionSize: 8GB
            nodeSelector:
              storage: local
            resources:
              requests:
                cpu: 200m
                memory: 1Gi
              limits:
                cpu: "2"
                memory: 3Gi
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            probeSelectorNilUsesHelmValues: false
            storageSpec:
              volumeClaimTemplate:
                spec:
                  storageClassName: local-path
                  accessModes:
                    - ReadWriteOnce
                  resources:
                    requests:
                      storage: 10Gi
        alertmanager:
          alertmanagerSpec:
            retention: 120h
            nodeSelector:
              storage: local
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                cpu: 500m
                memory: 512Mi
            storage:
              volumeClaimTemplate:
                spec:
                  storageClassName: local-path
                  accessModes:
                    - ReadWriteOnce
                  resources:
                    requests:
                      storage: 1Gi
        grafana:
          defaultDashboardsTimezone: America/St_Johns
          nodeSelector:
            storage: local
          persistence:
            enabled: true
            type: sts
            storageClassName: local-path
            accessModes:
              - ReadWriteOnce
            size: 2Gi
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          additionalDataSources:
            - name: Loki
              type: loki
              access: proxy
              url: http://loki.monitoring.svc.cluster.local:3100
              jsonData:
                maxLines: 1000
        additionalPrometheusRulesMap:
          pihole-dns:
            groups:
              - name: pihole-dns
                rules:
                  - alert: PiholeExporterDown
                    expr: absent(pihole_status)
                    for: 15m
                    labels:
                      severity: warning
                    annotations:
                      summary: Pi-hole exporter is not reporting metrics
                      description: No pihole_status metric for 15m; pihole-exporter is down or unscraped.
                  - alert: PiholeBlockingDisabled
                    expr: pihole_status == 0
                    for: 15m
                    labels:
                      severity: warning
                    annotations:
                      summary: Pi-hole blocking is disabled
                      description: pihole_status has been 0 (blocking off) for 15m.
                  - alert: PiholeNotBlocking
                    expr: (pihole_ads_percentage_today == 0) and (pihole_dns_queries_today > 100)
                    for: 1h
                    labels:
                      severity: warning
                    annotations:
                      summary: Pi-hole answers queries but blocks nothing
                      description: 0% blocked over 1h despite >100 queries today; gravity/blocklists may be broken.
                  - alert: PiholeGravityEmpty
                    expr: pihole_domains_being_blocked == 0
                    for: 30m
                    labels:
                      severity: warning
                    annotations:
                      summary: Pi-hole blocklist (gravity) is empty
                      description: pihole_domains_being_blocked == 0 for 30m; gravity failed to load.

  - name: loki
    namespace: monitoring
    createNamespace: true
    chart: grafana-community/loki
    version: "{{ cluster_addons_loki_version }}"
    values:
      - deploymentMode: SingleBinary
        loki:
          auth_enabled: false
          commonConfig:
            replication_factor: 1
          schemaConfig:
            configs:
              - from: "2024-04-01"
                store: tsdb
                object_store: filesystem
                schema: v13
                index:
                  prefix: index_
                  period: 24h
          storage:
            type: filesystem
          limits_config:
            retention_period: "{{ cluster_addons_loki_retention }}"
          compactor:
            retention_enabled: true
            delete_request_store: filesystem
          pattern_ingester:
            enabled: false
          ruler:
            enabled: false
        singleBinary:
          replicas: 1
          persistence:
            enabled: true
            storageClass: local-path
            size: "{{ cluster_addons_loki_storage_size }}"
          nodeSelector:
            storage: local
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
        read:
          replicas: 0
        write:
          replicas: 0
        backend:
          replicas: 0
        minio:
          enabled: false
        gateway:
          enabled: false
        chunksCache:
          enabled: false
        resultsCache:
          enabled: false
        lokiCanary:
          enabled: false
        test:
          enabled: false
