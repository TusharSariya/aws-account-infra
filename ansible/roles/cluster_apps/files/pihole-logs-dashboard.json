{
  "uid": "pihole-logs",
  "title": "Pi-hole — DNS query logs",
  "tags": ["pihole"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "loki",
        "label": "Data source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queries (1h)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"pihole\", action=\"query\"}[1h]))", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Blocked (1h)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"pihole\", action=\"blocked\"}[1h]))", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "NXDOMAIN (1h)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"pihole\"} |= `is NXDOMAIN` [1h]))", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Query volume by action",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (action) (count_over_time({job=\"pihole\"}[$__interval]))", "legendFormat": "{{action}}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top queried domains (1h)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "topk(15, sum by (domain) (count_over_time({job=\"pihole\", action=\"query\"} | regexp `query\\[[A-Z]+\\] (?P<domain>\\S+) from` [1h])))", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Live query stream",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true },
      "targets": [
        { "refId": "A", "expr": "{job=\"pihole\"}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ]
    }
  ]
}
