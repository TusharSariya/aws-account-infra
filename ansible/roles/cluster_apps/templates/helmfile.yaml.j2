---
helmDefaults:
  wait: true
  timeout: 900
  atomic: true

repositories:
  - name: mojo2600
    url: https://mojo2600.github.io/pihole-kubernetes/

releases:
  - name: pihole
    namespace: {{ cluster_apps_pihole_namespace }}
    createNamespace: true
    chart: mojo2600/pihole
    version: "{{ cluster_apps_pihole_chart_version }}"
    values:
      - image:
          tag: "{{ cluster_apps_pihole_image_tag }}"
        nodeSelector:
          storage: local
        # Put CoreDNS first so the Alloy sidecar can resolve loki.monitoring.svc
        # (Pi-hole itself stays reachable via the 127.0.0.1 fallback).
        podDnsConfig:
          enabled: true
          policy: "None"
          nameservers:
            - "{{ cluster_apps_cluster_dns }}"
            - 127.0.0.1
        serviceDns:
          # Single mixed TCP+UDP Service so one MetalLB IP serves both (matches the
          # retired raw manifest); avoids needing metallb allow-shared-ip.
          mixedService: true
          type: LoadBalancer
          externalTrafficPolicy: Local
          annotations:
            metallb.io/loadBalancerIPs: "{{ cluster_apps_pihole_dns_address }}"
        serviceDhcp:
          enabled: false
        serviceWeb:
          type: ClusterIP
        persistentVolumeClaim:
          enabled: true
          existingClaim: {{ cluster_apps_pihole_pvc }}
        admin:
          enabled: true
          existingSecret: {{ cluster_apps_pihole_secret }}
          passwordKey: password
        # FTL writes the dnsmasq query log to /var/log/pihole/pihole.log (a file,
        # not stdout) when queryLogging is true; the Alloy sidecar tails it.
        extraEnvVars:
          FTLCONF_dns_listeningMode: "all"
          FTLCONF_dns_queryLogging: "true"
          FTLCONF_dns_hostRecord: "{{ cluster_apps_grafana_hostname }},grafana,{{ cluster_apps_pihole_hostname }},{{ cluster_apps_gateway_address }}"
        # Shared emptyDir exposes the query log to the Alloy sidecar; alloy-config
        # is the rendered pihole-alloy-config ConfigMap.
        extraVolumes:
          pihole-logs:
            emptyDir: {}
          alloy-config:
            configMap:
              name: pihole-alloy-config
        extraVolumeMounts:
          pihole-logs:
            mountPath: /var/log/pihole
        extraContainers:
          - name: alloy
            image: {{ cluster_apps_alloy_image }}
            args:
              - run
              - /etc/alloy/config.alloy
              - --storage.path=/tmp/alloy
              - --disable-reporting
            securityContext:
              runAsUser: 0
            volumeMounts:
              - name: pihole-logs
                mountPath: /var/log/pihole
                readOnly: true
              - name: alloy-config
                mountPath: /etc/alloy
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                cpu: 200m
                memory: 128Mi
