{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TusharSariya/aws-account-infra/catalog/schema/service.schema.json",
  "title": "Service vending manifest",
  "oneOf": [
    { "$ref": "#/$defs/v1Manifest" },
    { "$ref": "#/$defs/v2Manifest" }
  ],
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "id", "display_name", "owner"],
      "properties": {
        "uid": { "type": "string", "format": "uuid" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,56}$" },
        "display_name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "repositoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "name", "visibility", "template"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "visibility": { "const": "private" },
        "template": { "type": ["string", "null"] },
        "migration": { "enum": ["template", "filtered-history"] }
      }
    },
    "repositoryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "name", "visibility", "template", "protection_profile", "spec_layout", "required_status_checks"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "visibility": { "const": "private" },
        "template": { "type": ["string", "null"] },
        "migration": { "enum": ["template", "filtered-history"] },
        "protection_profile": { "enum": ["service", "infrastructure", "template"] },
        "spec_layout": { "enum": ["root", "product"] },
        "required_status_checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "agent_data_access": { "enum": ["none", "read"] }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "name", "root_email", "ou_path", "region", "budget_usd", "deployment", "lifecycle"],
      "properties": {
        "account_id": { "type": ["string", "null"], "pattern": "^[0-9]{12}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "root_email": { "type": "string", "format": "email" },
        "ou_path": { "type": "string", "pattern": "^[A-Za-z0-9_. -]+(/[A-Za-z0-9_. -]+){1,2}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" },
        "budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "deployment": { "enum": ["automatic", "approval"] },
        "lifecycle": { "enum": ["active", "retired"] }
      }
    },
    "accountsV1": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/account" }
    },
    "accountsV2": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/account" }
    },
    "secretContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "keys", "owner", "rotation_id", "restart_on_rotation"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "type": { "enum": ["Opaque", "kubernetes.io/basic-auth", "kubernetes.io/tls"] },
        "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
        "owner": { "type": "string", "minLength": 1 },
        "rotation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "restart_on_rotation": { "type": "boolean" }
      }
    },
    "kubernetesTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "quota_profile", "ingress_hostname", "gpu_mode", "ecr_repository", "source_path", "backend", "secrets", "egress"],
      "properties": {
        "lifecycle": { "enum": ["active", "suspended", "archived"] },
        "quota_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "ingress_hostname": { "type": "string", "format": "hostname", "maxLength": 253 },
        "gpu_mode": { "const": "none" },
        "ecr_repository": { "type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$", "maxLength": 256 },
        "source_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$", "maxLength": 256 },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "port"],
          "properties": {
            "service": { "type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "secrets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/secretContract" } },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns_names"],
          "properties": {
            "dns_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "hostname" } }
          }
        }
      }
    },
    "kubernetesV1": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/kubernetesTarget" }
    },
    "kubernetesV2": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/kubernetesTarget" }
    },
    "supabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "organization_id", "project_name", "region", "plan", "storage", "backup_profile", "auth"],
      "properties": {
        "lifecycle": { "enum": ["active", "suspended", "archived", "purge_requested", "purged"] },
        "organization_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "project_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "project_ref": { "type": ["string", "null"], "pattern": "^[a-z]{20}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
        "plan": { "const": "free" },
        "storage": { "const": "disabled" },
        "backup_profile": { "const": "none" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "site_url", "redirect_urls", "public_signup"],
          "properties": {
            "mode": { "const": "operator-only" },
            "site_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "redirect_urls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
            "public_signup": { "const": false }
          }
        }
      }
    },
    "externalServices": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "supabase": { "$ref": "#/$defs/supabase" } }
    },
    "v1Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "provisioner", "service", "repository", "accounts", "kubernetes"],
      "properties": {
        "version": { "const": 1 },
        "provisioner": { "enum": ["organizations-v1", "aft-v1"] },
        "service": { "$ref": "#/$defs/service" },
        "repository": { "$ref": "#/$defs/repositoryV1" },
        "accounts": { "$ref": "#/$defs/accountsV1" },
        "kubernetes": { "$ref": "#/$defs/kubernetesV1" }
      }
    },
    "v2Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "provisioner", "service", "repository", "accounts", "kubernetes", "external_services"],
      "properties": {
        "version": { "const": 2 },
        "provisioner": { "const": "service-v2" },
        "service": { "$ref": "#/$defs/service" },
        "repository": { "$ref": "#/$defs/repositoryV2" },
        "accounts": { "$ref": "#/$defs/accountsV2" },
        "kubernetes": { "$ref": "#/$defs/kubernetesV2" },
        "external_services": { "$ref": "#/$defs/externalServices" }
      }
    }
  }
}
