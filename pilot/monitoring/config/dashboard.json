{
  "uid": "isolated-pilot",
  "title": "Isolated pilot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Pending work",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_pending_workloads",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Admission delay p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(pilot_admission_delay_seconds_bucket[15m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Worker ready transitions / retirement requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_worker_ready_transitions_total",
          "refId": "A"
        },
        {
          "expr": "pilot_worker_retirement_requests_total",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Controller health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_controller_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Controller restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(pilot_controller_restarts_total[15m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Host available memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_host_memory_bytes{kind=\"MemAvailable\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Swap pages / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(pilot_host_swap_pages_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Pilot Pod counts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_pods",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Collection health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_collection_success",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Storage budget consumption",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_data_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Worker desired / paused / ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_worker_desired",
          "refId": "A"
        },
        {
          "expr": "pilot_worker_paused",
          "refId": "B"
        },
        {
          "expr": "pilot_worker_ready",
          "refId": "C"
        }
      ]
    },
    {
      "id": 99,
      "title": "Sanitized lifecycle events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "pilot-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "{service=\"prototype-primary-lifecycle\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "title": "Monitoring memory (systemd cgroups)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "pilot_monitoring_memory_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "title": "Monitoring CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(pilot_monitoring_cpu_seconds_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "title": "Lifecycle error events (sanitized journal)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "pilot-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"prototype-primary-lifecycle\"} |~ \"error|failed|No route to host\" [5m]))",
          "refId": "A",
          "queryType": "range"
        }
      ]
    }
  ]
}
